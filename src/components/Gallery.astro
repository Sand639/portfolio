---
import WorkCard from './WorkCard.astro';
import { type Work, CATEGORIES } from '../lib/works';

interface Props {
  works: Work[];
}

const { works } = Astro.props;

const catCounts = Object.fromEntries(
  Object.keys(CATEGORIES).map((c) => [c, works.filter((w) => w.data.category === c).length]),
);

// タグは使用数の多い順 → 名前順
const tagCounts = new Map<string, number>();
for (const w of works) for (const t of w.data.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const allTags = [...tagCounts.keys()].sort(
  (a, b) => tagCounts.get(b)! - tagCounts.get(a)! || a.localeCompare(b, 'ja'),
);
---

<section class="gallery" data-gallery>
  <div class="controls" data-controls hidden>
    <div class="tabs" role="group" aria-label="カテゴリ">
      <button type="button" data-cat-btn="" aria-pressed="true">すべて <span>{works.length}</span></button>
      {
        Object.entries(CATEGORIES).map(([key, label]) => (
          <button type="button" data-cat-btn={key} aria-pressed="false">
            {label} <span>{catCounts[key]}</span>
          </button>
        ))
      }
    </div>

    <div class="row">
      <label class="search">
        <span class="visually-hidden">キーワード検索</span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="9" cy="9" r="6" /><path d="m14 14 4 4" /></svg>
        <input type="search" data-q placeholder="作品名・タグで検索" autocomplete="off" />
      </label>
      <label class="sort">
        <span class="visually-hidden">並べ替え</span>
        <select data-sort>
          <option value="new">新しい順</option>
          <option value="old">古い順</option>
          <option value="name">作品名順</option>
        </select>
      </label>
    </div>

    <div class="tagbar" data-tagbar>
      <span class="tagbar-label" id="tag-label">タグ（すべて含む作品）</span>
      <div class="tag-list" role="group" aria-labelledby="tag-label">
        {
          allTags.map((t) => (
            <button type="button" class="tag" data-tag={t} aria-pressed="false">
              {t}
            </button>
          ))
        }
      </div>
    </div>

    <div class="status">
      <p aria-live="polite"><strong data-count>{works.length}</strong> 件</p>
      <button type="button" class="clear" data-clear hidden>条件をクリア</button>
    </div>
  </div>

  <ul class="grid" data-grid>
    {works.map((w, i) => <WorkCard work={w} eager={i < 3} />)}
  </ul>

  <p class="empty" data-empty hidden></p>
</section>

<script>
  type Sort = 'new' | 'old' | 'name';

  const root = document.querySelector<HTMLElement>('[data-gallery]')!;
  const controls = root.querySelector<HTMLElement>('[data-controls]')!;
  const grid = root.querySelector<HTMLUListElement>('[data-grid]')!;
  const qInput = root.querySelector<HTMLInputElement>('[data-q]')!;
  const sortSel = root.querySelector<HTMLSelectElement>('[data-sort]')!;
  const countEl = root.querySelector<HTMLElement>('[data-count]')!;
  const clearBtn = root.querySelector<HTMLButtonElement>('[data-clear]')!;
  const emptyEl = root.querySelector<HTMLElement>('[data-empty]')!;
  const catBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-cat-btn]')];
  const tagBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-tag]')];
  const tagBar = root.querySelector<HTMLElement>('[data-tagbar]')!;
  const cards = [...grid.querySelectorAll<HTMLLIElement>(':scope > li')].map((el) => ({
    el,
    cat: el.dataset.cat ?? '',
    tags: JSON.parse(el.dataset.tags ?? '[]') as string[],
    order: Number(el.dataset.order),
    title: el.dataset.title ?? '',
    search: el.dataset.search ?? '',
  }));

  const state = {
    cat: '',
    q: '',
    tags: new Set<string>(),
    sort: 'new' as Sort,
  };

  // URL → 状態（共有されたリンクで同じ絞り込みを再現する）
  function readUrl() {
    const p = new URLSearchParams(location.search);
    const cat = p.get('cat') ?? '';
    state.cat = catBtns.some((b) => b.dataset.catBtn === cat) ? cat : '';
    state.q = p.get('q') ?? '';
    state.tags = new Set((p.get('tags') ?? '').split(',').filter(Boolean));
    const sort = p.get('sort');
    state.sort = sort === 'old' || sort === 'name' ? sort : 'new';
  }

  function writeUrl() {
    const p = new URLSearchParams();
    if (state.cat) p.set('cat', state.cat);
    if (state.q) p.set('q', state.q);
    if (state.tags.size) p.set('tags', [...state.tags].join(','));
    if (state.sort !== 'new') p.set('sort', state.sort);
    const qs = p.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  function matches(c: (typeof cards)[number], ignoreTags = false) {
    if (state.cat && c.cat !== state.cat) return false;
    const words = state.q.toLowerCase().split(/\s+/).filter(Boolean);
    if (!words.every((w) => c.search.includes(w))) return false;
    if (!ignoreTags) for (const t of state.tags) if (!c.tags.includes(t)) return false;
    return true;
  }

  function render() {
    // 並べ替え
    const sorted = [...cards].sort((a, b) =>
      state.sort === 'old' ? a.order - b.order
      : state.sort === 'name' ? a.title.localeCompare(b.title, 'ja')
      : b.order - a.order,
    );
    sorted.forEach((c) => grid.appendChild(c.el));

    // 絞り込み
    const visible = cards.filter((c) => matches(c));
    cards.forEach((c) => (c.el.hidden = !visible.includes(c)));
    countEl.textContent = String(visible.length);

    // コントロールの表示を状態に合わせる
    catBtns.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.catBtn ?? '') === state.cat)));
    const inScope = cards.filter((c) => matches(c, true));
    tagBtns.forEach((b) => {
      const tag = b.dataset.tag!;
      const on = state.tags.has(tag);
      b.setAttribute('aria-pressed', String(on));
      // 今の条件にこのタグを足すと 0 件になるなら押せなくする（選択中のタグは外せるように残す）
      const reachable = visible.some((c) => c.tags.includes(tag)) || on;
      b.disabled = !reachable;
      b.hidden = !inScope.some((c) => c.tags.includes(tag)) && !on;
    });
    tagBar.hidden = tagBtns.every((b) => b.hidden);
    if (qInput.value !== state.q) qInput.value = state.q;
    sortSel.value = state.sort;

    const filtered = Boolean(state.cat || state.q || state.tags.size);
    clearBtn.hidden = !filtered;

    const catEmpty = state.cat && !cards.some((c) => c.cat === state.cat);
    emptyEl.hidden = visible.length > 0;
    emptyEl.textContent = catEmpty ? 'このカテゴリの作品は準備中です。' : '条件に合う作品がありません。';
  }

  function update() {
    writeUrl();
    render();
  }

  catBtns.forEach((b) =>
    b.addEventListener('click', () => {
      state.cat = b.dataset.catBtn ?? '';
      update();
    }),
  );
  tagBtns.forEach((b) =>
    b.addEventListener('click', () => {
      const t = b.dataset.tag!;
      state.tags.has(t) ? state.tags.delete(t) : state.tags.add(t);
      update();
    }),
  );
  qInput.addEventListener('input', () => {
    state.q = qInput.value.trim();
    update();
  });
  sortSel.addEventListener('change', () => {
    state.sort = sortSel.value as Sort;
    update();
  });
  clearBtn.addEventListener('click', () => {
    state.cat = '';
    state.q = '';
    state.tags.clear();
    update();
    qInput.focus();
  });

  readUrl();
  controls.hidden = false;
  render();
</script>

<style>
  .controls {
    display: grid;
    gap: 14px;
    margin-bottom: 24px;
  }
  .controls[hidden] { display: none; }

  .tabs {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    border-bottom: 1px solid var(--border);
    scrollbar-width: none;
  }
  .tabs button {
    flex: none;
    padding: 8px 14px;
    border: 0;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    background: none;
    color: var(--muted);
    font: inherit;
    font-size: 0.9375rem;
    cursor: pointer;
  }
  .tabs button span { font-size: 0.75rem; margin-left: 2px; font-variant-numeric: tabular-nums; }
  .tabs button:hover { color: var(--text); }
  .tabs button[aria-pressed='true'] {
    color: var(--text);
    font-weight: 600;
    border-bottom-color: var(--accent);
  }

  .row { display: flex; gap: 8px; }
  .search { position: relative; flex: 1; min-width: 0; }
  .search svg {
    position: absolute;
    left: 12px;
    top: 50%;
    width: 16px;
    height: 16px;
    transform: translateY(-50%);
    fill: none;
    stroke: var(--muted);
    stroke-width: 2;
    stroke-linecap: round;
    pointer-events: none;
  }
  input, select {
    width: 100%;
    height: 40px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 16px; /* iOS のズームを防ぐ */
  }
  input { padding: 0 12px 0 36px; }
  select { padding: 0 10px; cursor: pointer; }
  .sort { flex: none; width: 128px; }
  input:focus-visible, select:focus-visible { outline-offset: 0; border-color: var(--accent); }

  .tagbar { display: grid; gap: 6px; }
  .tagbar[hidden] { display: none; }
  .tagbar-label { color: var(--muted); font-size: 0.8125rem; }
  .tag-list { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag-list .tag { cursor: pointer; font: inherit; font-size: 0.8125rem; }
  .tag-list .tag:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
  .tag-list .tag[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .tag-list .tag[aria-pressed='true']::before { content: '✓'; font-size: 0.75em; }
  .tag-list .tag:disabled { opacity: 0.4; cursor: default; }
  .tag-list .tag[hidden] { display: none; }

  .status { display: flex; align-items: center; gap: 12px; min-height: 28px; }
  .status p { margin: 0; color: var(--muted); font-size: 0.875rem; }
  .status strong { color: var(--text); font-variant-numeric: tabular-nums; }
  .clear {
    padding: 2px 10px;
    border: 0;
    border-radius: 6px;
    background: var(--accent-soft);
    color: var(--accent);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }
  .clear[hidden] { display: none; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
  }
  .empty {
    padding: 48px 16px;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    color: var(--muted);
    text-align: center;
  }
  .empty[hidden] { display: none; }
</style>
