---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getWorks, type Work, CATEGORIES, isPreparing, url, workNumber, youtubeId } from '../../lib/works';

export const getStaticPaths = (async () => {
  const works = await getWorks(); // 新しい順
  return works.map((work, i) => {
    // 同じタグを多く共有する作品を最大3件
    const related = works
      .filter((w) => w.id !== work.id)
      .map((w) => ({ w, score: w.data.tags.filter((t) => work.data.tags.includes(t)).length }))
      .filter((x) => x.score > 0)
      .sort((a, b) => b.score - a.score || b.w.data.order - a.w.data.order)
      .slice(0, 3)
      .map((x) => x.w);
    return {
      params: { slug: work.id },
      props: { work, newer: works[i - 1], older: works[i + 1], related },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  work: Work;
  newer?: Work;
  older?: Work;
  related: Work[];
}

const { work, newer, older, related } = Astro.props;
const { title, summary, category, tags, period, team, role, hours, thumbnail, youtube, links } = work.data;
const { Content } = await render(work);
const hasBody = Boolean(work.body?.trim());
const ytId = youtubeId(youtube);
const facts = [
  { label: '制作時期', value: period },
  { label: '体制', value: team },
  { label: '担当', value: role },
  { label: '制作時間', value: hours !== undefined ? `約${hours}時間` : undefined },
].filter((f) => f.value);
---

<BaseLayout title={title} description={summary ?? `${title}（${CATEGORIES[category]}）`}>
  <article class="container">
    <nav class="crumb" aria-label="パンくず">
      <a href={url('/')}>作品</a>
      <span aria-hidden="true">/</span>
      <a href={url(`/?cat=${category}`)}>{CATEGORIES[category]}</a>
    </nav>

    <header class="head">
      <p class="num">
        {workNumber(work)}
        {isPreparing(work) && <span class="badge-preparing">準備中</span>}
      </p>
      <h1>{title}</h1>
      {summary && <p class="lead">{summary}</p>}
      {
        tags.length > 0 && (
          <ul class="tags" aria-label="タグ">
            {tags.map((t) => (
              <li>
                <a class="tag" href={url(`/?tags=${encodeURIComponent(t)}`)}>{t}</a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      ytId ? (
        <div class="media video">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${ytId}`}
            title={`${title} の動画`}
            loading="lazy"
            allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          />
        </div>
      ) : thumbnail ? (
        <div class="media">
          <Image src={thumbnail} alt={`${title} の画面`} widths={[800, 1600]} sizes="(min-width: 1120px) 1056px, 100vw" />
        </div>
      ) : null
    }

    {
      facts.length > 0 && (
        <dl class="facts">
          {facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      hasBody ? (
        <div class="prose">
          <Content />
        </div>
      ) : (
        <p class="preparing">この作品の詳細は準備中です。</p>
      )
    }

    {
      links.length > 0 && (
        <ul class="links">
          {links.map((l) => (
            <li>
              <a href={l.url} target="_blank" rel="noopener noreferrer">
                {l.label} ↗
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <nav class="pager" aria-label="前後の作品">
      {
        newer ? (
          <a class="newer" href={url(`/works/${newer.id}/`)}>
            <span>← 次に作った作品</span>
            <strong>{newer.data.title}</strong>
          </a>
        ) : (
          <span />
        )
      }
      {
        older && (
          <a class="older" href={url(`/works/${older.id}/`)}>
            <span>前に作った作品 →</span>
            <strong>{older.data.title}</strong>
          </a>
        )
      }
    </nav>

    {
      related.length > 0 && (
        <section class="related">
          <h2>同じ技術の作品</h2>
          <ul>
            {related.map((w) => (
              <WorkCard work={w} />
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  article { padding-top: 24px; }
  .crumb { display: flex; gap: 8px; color: var(--muted); font-size: 0.875rem; }
  .crumb a { color: var(--muted); text-decoration: none; }
  .crumb a:hover { color: var(--accent); }

  .head { margin: 24px 0 28px; }
  .num {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: var(--muted);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
  }
  h1 { margin-top: 4px; font-size: 1.75rem; overflow-wrap: anywhere; }
  @media (min-width: 768px) { h1 { font-size: 2.25rem; } }
  .lead { margin: 12px 0 0; font-size: 1.0625rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 16px 0 0; padding: 0; list-style: none; }

  .media {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
  }
  .media :global(img) { width: 100%; height: auto; }
  .video { aspect-ratio: 16 / 9; }
  .video iframe { width: 100%; height: 100%; border: 0; }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1px;
    margin: 28px 0 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--border);
  }
  .facts div { padding: 12px 16px; background: var(--bg); }
  .facts dt { color: var(--muted); font-size: 0.75rem; }
  .facts dd { margin: 2px 0 0; font-weight: 600; }

  .prose { max-width: 760px; margin-top: 36px; }
  .prose :global(h2) { margin: 40px 0 12px; padding-bottom: 6px; border-bottom: 1px solid var(--border); font-size: 1.25rem; }
  .prose :global(h3) { margin: 28px 0 8px; font-size: 1.0625rem; }
  .prose :global(img) { height: auto; border-radius: 8px; }
  .prose :global(code) { padding: 1px 6px; border-radius: 4px; background: var(--surface); font-size: 0.9em; }
  .prose :global(pre) { padding: 16px; border-radius: 8px; overflow-x: auto; }
  .prose :global(pre code) { padding: 0; background: none; }
  .prose :global(ul) { padding-left: 1.4em; }
  .prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 8px 14px;
    border: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) { background: var(--surface); font-weight: 600; white-space: nowrap; }

  .preparing {
    margin-top: 36px;
    padding: 40px 16px;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    color: var(--muted);
    text-align: center;
  }

  .links { display: flex; flex-wrap: wrap; gap: 8px; margin: 28px 0 0; padding: 0; list-style: none; }
  .links a {
    display: inline-block;
    padding: 8px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
  }
  .links a:hover { border-color: var(--accent); }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 56px;
  }
  .pager a {
    display: grid;
    gap: 2px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    min-width: 0;
  }
  .pager a:hover { border-color: var(--accent); }
  .pager span { color: var(--muted); font-size: 0.8125rem; }
  .pager strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pager .older { text-align: right; grid-column: 2; }

  .related { margin-top: 56px; }
  .related h2 { margin-bottom: 16px; font-size: 1.125rem; }
  .related ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
  }
</style>
